# ===== 生态养殖系统 环境变量示例 =====
# 使用方法：
#   1. 把本文件复制一份并命名为 .env（注意：.env 已被 .gitignore 忽略，不会提交到 GitHub）
#   2. 按你本机的实际情况修改下面的值
#   3. 后端启动时会自动读取项目根目录下的 .env

# Django 密钥（生产环境请替换为随机长字符串）
# 生成方式：python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=请替换为随机密钥

# 调试模式：True / False（生产环境请设为 False）
DJANGO_DEBUG=True

# 允许访问的主机，多个用英文逗号分隔；开发环境用 * 即可
DJANGO_ALLOWED_HOSTS=*

# ===== MySQL 数据库配置 =====
DB_NAME=ecological_breeding_system
DB_USER=root
# 改成你本机 MySQL 的密码（导入 database/ecological_breeding_system.sql 后即可使用）
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# 溯源二维码中写入的公网访问地址（部署到服务器时填写，例如 https://example.com；本地运行留空即可）
TRACE_PUBLIC_BASE_URL=
